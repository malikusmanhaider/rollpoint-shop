# ================================================================
# ROLLPOINT E-COMMERCE ENVIRONMENT CONFIGURATION
# ================================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection URI:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/rollpoint?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://rollpoint_admin:SecurePassword123@cluster0.mongodb.net/rollpoint?retryWrites=true&w=majority

# Admin & JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=rollpoint_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Default Initial Admin (Created on first run if database is empty)
DEFAULT_ADMIN_NAME=RollPoint Admin
DEFAULT_ADMIN_EMAIL=admin@rollpoint.pk
DEFAULT_ADMIN_PASSWORD=admin123

# WhatsApp Business Information (Used for order routing)
WHATSAPP_NUMBER=03089134302
WHATSAPP_INTL=923089134302

# Business / Store Information
STORE_NAME=RollPoint
STORE_EMAIL=malikusmanhaider0346@gmail.com
STORE_ADDRESS=Rehmat Plaza, Pakistan Town Phase 2 Rd, near Allah Wali Masjid, Phase 2 Islamabad, 45720, Pakistan
GOOGLE_MAPS_URL=https://maps.app.goo.gl/N9xDnGzuN3n8PbCD6?g_st=awb
STORE_HOURS=Mon–Sat · 10:00 am – 8:00 pm
FLAT_SHIPPING_RATE=250

# Client Origin for CORS (e.g. https://your-site.netlify.app in production)
CLIENT_URL=*

# Cloudinary Image Hosting (Free CDN - https://cloudinary.com)
# Images will be saved directly as optimized WebP URLs without server load
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
